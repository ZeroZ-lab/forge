{
  "version": 2,
  "name": "forge-skills-suite-benchmark",
  "description": "A deterministic v2 contract for checking whether Forge skills are triggered, bounded, verified, traceable through Change Units, and rebuild-aware during representative agent runs.",
  "minimum_cases": 10,
  "report_schema": "evals/skills-suite/report.schema.json",
  "evaluation_axes": [
    "skill routing",
    "artifact production",
    "decision gates",
    "verification evidence",
    "scope control",
    "change unit traceability",
    "doc sync completion",
    "rebuild control coverage"
  ],
  "cases": [
    {
      "id": "ambiguous-idea-alignment",
      "title": "模糊想法收敛到业务方向",
      "level": "L2 stage",
      "fixture": "evals/skills-suite/fixtures/ambiguous-idea-alignment.md",
      "expected_skills": [
        "forge-brainstorm",
        "forge-business-alignment"
      ],
      "expected_artifacts": [
        "docs/idea-brief.md",
        "docs/project.md",
        "docs/change-units/CU-*.md",
        "docs/CURRENT_STATE.md"
      ],
      "required_evidence": [
        "triggered skills",
        "direction map",
        "go/no-go decision",
        "Change Unit"
      ],
      "forbidden_behaviors": [
        "generated_code_without_contract",
        "skipped_business_decision",
        "current_docs_without_change_unit"
      ],
      "oracle_checks": [
        {
          "type": "skill_triggered",
          "skill": "forge-brainstorm"
        },
        {
          "type": "skill_triggered",
          "skill": "forge-business-alignment"
        },
        {
          "type": "artifact_reported",
          "path": "docs/idea-brief.md"
        },
        {
          "type": "decision_gate_reported",
          "decision": "business_go_no_go"
        },
        {
          "type": "forbidden_behavior_absent",
          "behavior": "generated_code_without_contract"
        },
        {
          "type": "change_unit_reported",
          "path": "docs/change-units/CU-*.md"
        },
        {
          "type": "forbidden_behavior_absent",
          "behavior": "current_docs_without_change_unit"
        },
        {
          "type": "doc_sync_completed",
          "target": "docs/CURRENT_STATE.md"
        }
      ]
    },
