        "forge-brainstorm",
        "forge-business-alignment"
      ],
      "expected_artifacts": [
        "docs/idea-brief.md",
        "docs/project.md",
        "docs/change-units/CU-*.md",
        "goal.md"
      ],
      "required_evidence": [
        "triggered skills",
        "direction map",
        "go/no-go decision",
        "Change Unit"
      ],
      "forbidden_behaviors": [
        "generated_code_without_contract",
        "skipped_business_decision",
        "current_docs_without_change_unit"
      ],
      "oracle_checks": [
        {
          "type": "skill_triggered",
          "skill": "forge-brainstorm"
        },
        {
          "type": "skill_triggered",
          "skill": "forge-business-alignment"
        },
        {
          "type": "artifact_reported",
          "path": "docs/idea-brief.md"
        },
        {
          "type": "decision_gate_reported",
          "decision": "business_go_no_go"
        },
        {
          "type": "forbidden_behavior_absent",
          "behavior": "generated_code_without_contract"
        },
        {
          "type": "change_unit_reported",
          "path": "docs/change-units/CU-*.md"
        },
        {
          "type": "forbidden_behavior_absent",
          "behavior": "current_docs_without_change_unit"
        },
        {
          "type": "goal_verified",
          "target": "goal.md"
        }
