{
  "version": 2,
  "name": "forge-skills-suite-benchmark",
  "description": "A deterministic v2 contract for checking whether Forge skills are triggered through complete, non-redundant chains; bounded, verified, traceable through Change Units, and goal-aware during representative agent runs.",
  "minimum_cases": 14,
  "scoring_model": {
    "version": 1,
    "grade_thresholds": {
      "A": 90,
      "B": 80,
      "C": 70,
      "D": 60,
      "F": 0
    },
    "axes": [
      {
        "id": "routing",
        "label": "Skill routing",
        "weight": 15
      },
      {
        "id": "artifacts",
        "label": "Artifact completeness",
        "weight": 15
      },
      {
        "id": "decisions",
        "label": "Decision gates",
        "weight": 10
      },
      {
        "id": "verification",
        "label": "Verification evidence",
        "weight": 15
      },
      {
        "id": "scope_control",
        "label": "Scope control",
        "weight": 15
      },
      {
        "id": "traceability",
        "label": "Traceability",
        "weight": 20
      },
      {
        "id": "goal_verification",
        "label": "Goal verification coverage",
        "weight": 10
      }
    ]
  },
  "report_schema": "evals/skills-suite/report.schema.json",
  "evaluation_axes": [
    "skill routing",
    "artifact production",
    "decision gates",
    "verification evidence",
    "scope control",
    "change unit traceability",
    "goal verification coverage"
  ],
  "cases": [
    {
      "id": "ambiguous-idea-alignment",
      "title": "模糊想法收敛到业务方向",
      "level": "stage",
      "fixture": "evals/skills-suite/fixtures/ambiguous-idea-alignment.md",
      "expected_skills": [
        "brainstorm",
        "business-alignment"
      ],
      "expected_artifacts": [
        "docs/idea-brief.md",
        "docs/project.md",
        "docs/change-units/CU-*.md",
        "goal.md"
      ],
      "required_evidence": [
        "triggered skills",
        "direction map",
        "go/no-go decision",
        "Change Unit"
      ],
      "forbidden_behaviors": [
        "generated_code_without_contract",
        "skipped_business_decision",
        "current_docs_without_change_unit"
      ],
      "oracle_checks": [
        {
          "type": "skill_triggered",
          "skill": "brainstorm"
        },
        {
          "type": "skill_triggered",
          "skill": "business-alignment"
        },
        {
          "type": "artifact_reported",
          "path": "docs/idea-brief.md"
        },
        {
          "type": "decision_gate_reported",
          "decision": "business_go_no_go"
        },
        {
          "type": "forbidden_behavior_absent",
          "behavior": "generated_code_without_contract"
        },
        {
          "type": "change_unit_reported",
          "path": "docs/change-units/CU-*.md"
        },
        {
          "type": "forbidden_behavior_absent",
          "behavior": "current_docs_without_change_unit"
        },
        {
          "type": "goal_verified",
          "target": "goal.md"
        }
      ]
    },
