{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/forge/skills-suite-report.schema.json",
  "title": "Forge skills-suite evaluation report",
  "type": "object",
  "required": ["version", "suite", "run_id", "cases"],
  "properties": {
    "version": { "const": 2 },
    "suite": { "const": "forge" },
    "run_id": { "type": "string", "minLength": 1 },
    "model": { "type": "string" },
    "runner": { "type": "string" },
    "started_at": { "type": "string" },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "status",
          "triggered_skills",
          "artifacts",
          "change_units",
          "doc_sync",
          "code_map_entries",
          "commands_run",
          "evidence"
        ],
        "properties": {
          "case_id": { "type": "string" },
          "status": { "enum": ["pass", "fail", "blocked"] },
          "triggered_skills": { "type": "array", "items": { "type": "string" } },
          "artifacts": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "required": ["path"],
                  "properties": {
                    "path": { "type": "string" },
                    "action": { "type": "string" }
                  }
                }
              ]
            }
          },
          "change_units": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string", "pattern": "^docs/change-units/CU-[^/]+\\.md$" },
                {
                  "type": "object",
                  "required": ["path"],
                  "properties": {
                    "path": { "type": "string", "pattern": "^docs/change-units/CU-[^/]+\\.md$" },
                    "type": { "type": "string" },
                    "status": { "type": "string" }
                  }
                }
              ]
            }
          },
          "doc_sync": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["target", "status"],
              "properties": {
                "target": { "type": "string" },
                "status": { "enum": ["completed", "pending", "blocked"] },
                "notes": { "type": "string" }
              }
            }
          },
          "code_map_entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source", "projects_to"],
              "properties": {
                "source": { "type": "string", "pattern": "^docs/" },
                "projects_to": { "type": "array", "items": { "type": "string" } },
                "notes": { "type": "string" }
              }
            }
          },
          "commands_run": { "type": "array", "items": { "type": "string" } },
          "decisions": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "required": ["id"],
                  "properties": {
                    "id": { "type": "string" },
                    "choice": { "type": "string" }
                  }
                }
              ]
            }
          },
          "forbidden_behaviors": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
